<h1>Reset Your Password</h1>

<%= form_with model: @user, url: password_path, local: true do |form| %>
  <%= form.hidden_field :reset_password_token, value: @token %>

  <% if @user&.errors&.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :password, "New Password" %><br>
    <%= form.password_field :password, required: true, minlength: 6, autofocus: true %>
    <small>Minimum 6 characters</small>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm New Password" %><br>
    <%= form.password_field :password_confirmation, required: true %>
  </div>

  <div>
    <%= form.submit "Reset password" %>
  </div>
<% end %>

<p>
  <%= link_to "Back to login", login_path %>
</p>
