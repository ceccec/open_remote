<h1>Admin Login</h1>

<%= form_with url: login_path, method: :post, local: true do |form| %>
  <% if flash[:alert] %>
    <div class="alert alert-danger">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <div class="alert alert-info">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email, autofocus: true, required: true %>
  </div>

  <div>
    <%= form.label :password %><br>
    <%= form.password_field :password, required: true %>
  </div>

  <div>
    <%= form.check_box :remember_me %>
    <%= form.label :remember_me, "Remember me" %>
  </div>

  <div>
    <%= form.submit "Log in" %>
  </div>
<% end %>

<p>
  <%= link_to "Forgot your password?", new_password_path %> |
  <%= link_to "Resend confirmation instructions", new_confirmation_path %> |
  <%= link_to "Sign up", signup_path %>
</p>

