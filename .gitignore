# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Test/coverage output (generated)
/coverage/

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# Vite Ruby / Node.js
node_modules
# Package manager lock files (using npm only)
yarn.lock
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

# Local OpenRemote source checkout
/tmp/openremote

# YARD output (generated)
/.yardoc/
/doc/

# VitePress documentation build artifacts
/docs/.vitepress/dist
/docs/.vitepress/cache
/docs/node_modules
/docs/.vitepress/.temp
/docs/.vitepress/.cache
/docs/public/

# VitePress temporary files (now stored in tmp/vitepress-cache, which is already ignored via /tmp/*)
*.vitepress-temp
.vitepress-temp/

# Public directory - ignore all generated build artifacts and documentation
# (All files in public/ are generated by Vite/VitePress builds)
# 
# Note: If you need to track static files in public/, add exceptions like:
#   !/public/robots.txt
#   !/public/favicon.ico
#   !/public/404.html  (only if it's a static Rails error page, not generated)
/public/*
!/public/.keep

# Vendor (keep directory via .keep)
/vendor/*
!/vendor/.keep

# Built gem artifacts
/open_remote-*.gem
